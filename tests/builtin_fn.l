(include "core/assert.l")

;; `fn` structure: (fn ([ARGS...] [(rest REST_ARG)]) BODY...)

;; Wrong number of arguments.
(assert-eq (fn)
           (error `(too-few-args-to-builtin ~fn 0 2)))
(assert-eq (fn 1)
           (error `(too-few-args-to-builtin ~fn 1 2)))

;; Wrong type of argument.
(assert-eq (fn 1 nil)
           (error `(wrong-type-arg-to-builtin ~fn 1 ~list-t)))
(assert-eq (fn (1 a) nil)
           (error `(wrong-type-arg-to-builtin ~fn (1 a)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (1)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (1))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (1 2)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (1 2))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (1 2 3)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (1 2 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (abc 3)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (abc 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (rest 3)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c (rest 3)) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (fn (a b c 1) nil)
           (error `(wrong-type-arg-to-builtin ~fn (a b c 1)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))

;; Argument matching.
(let ((func (fn () empty)))
  (assert-eq (func) empty)
  (assert-eq (func 1)
             (error `(too-many-args ~func))))

(let ((func (fn (a) `(~a))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1) '(1))
  (assert-eq (func 1 2)
             (error `(too-many-args ~func))))

(let ((func (fn (a b) `(~a ~b))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2) '(1 2))
  (assert-eq (func 1 2 3)
             (error `(too-many-args ~func))))

(let ((func (fn (a b c) `(~a ~b ~c))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2 3) '(1 2 3))
  (assert-eq (func 1 2 3 4)
             (error `(too-many-args ~func))))

(let ((func (fn ((rest r)) `(~r))))
  (assert-eq (func) '(()))
  (assert-eq (func 1) '((1)))
  (assert-eq (func 1 2) '((1 2))))

(let ((func (fn (a (rest r)) `(~a ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1) '(1 ()))
  (assert-eq (func 1 2) '(1 (2)))
  (assert-eq (func 1 2 3) '(1 (2 3))))

(let ((func (fn (a b (rest r)) `(~a ~b ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2) '(1 2 ()))
  (assert-eq (func 1 2 3) '(1 2 (3))))

(let ((func (fn (a b c (rest r)) `(~a ~b ~c ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2 3) '(1 2 3 ())))

(include "core/assert.l")

;; `fn` and `macro` structure: (fn|macro ([ARGS...] [(rest REST_ARG)]) BODY...)

(setg fn-macro-tests
      (fn (builtin)

          ;; Wrong number of arguments.
          (assert-eq (builtin)
                     (error (list 'too-few-args-to-builtin builtin 0 2)))
          (assert-eq (builtin 1)
                     (error (list 'too-few-args-to-builtin builtin 1 2)))

          ;; Wrong type of argument.
          (assert-eq (builtin 1 nil)
                     (error (list 'wrong-type-arg-to-builtin builtin 1 list-t)))
          (assert-eq (builtin (1 a) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin (list 1 'a)
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (1)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (1))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (1 2)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (1 2))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (1 2 3)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (1 2 3))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (abc 3)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (abc 3))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (rest 3)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (rest 3))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c (rest 3)) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c (rest 3))
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
          (assert-eq (builtin (a b c 1) nil)
                     (error (list 'wrong-type-arg-to-builtin builtin '(a b c 1)
                                  "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))

          ;; Argument matching.
          (let ((func (builtin () ())))
            (assert-eq (func) ())
            (assert-eq (func 1)
                       (error (list 'too-many-args func))))

          (let ((func (builtin (a) (list a))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1) (list 1))
            (assert-eq (func 1 2)
                       (error (list 'too-many-args func))))

          (let ((func (builtin (a b) (list a b))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2) (list 1 2))
            (assert-eq (func 1 2 3)
                       (error (list 'too-many-args func))))

          (let ((func (builtin (a b c) (list a b c))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2 3) (list 1 2 3))
            (assert-eq (func 1 2 3 4)
                       (error (list 'too-many-args func))))

          (let ((func (builtin ((rest r)) (list r))))
            (assert-eq (func) (list ()))
            (assert-eq (func 1) (list (list 1)))
            (assert-eq (func 1 2) (list (list 1 2))))

          (let ((func (builtin (a (rest r)) (list a r))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1) (list 1 ()))
            (assert-eq (func 1 2) (list 1 (list 2)))
            (assert-eq (func 1 2 3) (list 1 (list 2 3))))

          (let ((func (builtin (a b (rest r)) (list a b r))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2) (list 1 2 ()))
            (assert-eq (func 1 2 3) (list 1 2 (list 3))))

          (let ((func (builtin (a b c (rest r)) (list a b c r))))
            (assert-eq (func)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2)
                       (error (list 'too-few-args func)))
            (assert-eq (func 1 2 3) (list 1 2 3 ())))))

(fn-macro-tests fn)
(fn-macro-tests macro)

(include "core/assert.l")

;; `macro` structure: (macro ([ARGS...] [(rest REST_ARG)]) BODY...)

;; Wrong number of arguments.
(assert-eq (macro)
           (error (list 'too-few-args-to-builtin macro 0 2)))
(assert-eq (macro 1)
           (error (list 'too-few-args-to-builtin macro 1 2)))

;; Wrong type of argument.
(assert-eq (macro 1 nil)
           (error (list 'wrong-type-arg-to-builtin macro 1 list-t)))
(assert-eq (macro (1 a) nil)
           (error (list 'wrong-type-arg-to-builtin macro (list 1 'a)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (1))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1 2)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (1 2))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1 2 3)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (1 2 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (abc 3)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (abc 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (rest 3)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (rest 3)) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c 1) nil)
           (error (list 'wrong-type-arg-to-builtin macro '(a b c 1)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))

;; Argument matching.
(let ((func (macro () ())))
  (assert-eq (func) ())
  (assert-eq (func 1)
             (error (list 'too-many-args func))))

(let ((func (macro (a) (list list a))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1) (list 1))
  (assert-eq (func 1 2)
             (error (list 'too-many-args func))))

(let ((func (macro (a b) (list list a b))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2) (list 1 2))
  (assert-eq (func 1 2 3)
             (error (list 'too-many-args func))))

(let ((func (macro (a b c) (list list a b c))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2 3) (list 1 2 3))
  (assert-eq (func 1 2 3 4)
             (error (list 'too-many-args func))))

(let ((func (macro ((rest r)) (list list (cons list r)))))
  (assert-eq (func) (list ()))
  (assert-eq (func 1) (list (list 1)))
  (assert-eq (func 1 2) (list (list 1 2))))

(let ((func (macro (a (rest r)) (list list a (cons list r)))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1) (list 1 ()))
  (assert-eq (func 1 2) (list 1 (list 2)))
  (assert-eq (func 1 2 3) (list 1 (list 2 3))))

(let ((func (macro (a b (rest r)) (list list a b (cons list r)))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2) (list 1 2 ()))
  (assert-eq (func 1 2 3) (list 1 2 (list 3))))

(let ((func (macro (a b c (rest r)) (list list a b c (cons list r)))))
  (assert-eq (func)
             (error (list 'too-few-args func)))
  (assert-eq (func 1)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2)
             (error (list 'too-few-args func)))
  (assert-eq (func 1 2 3) (list 1 2 3 ())))

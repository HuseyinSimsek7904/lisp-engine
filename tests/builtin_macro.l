(include "core/assert.l")

;; `macro` structure: (macro ([ARGS...] [(rest REST_ARG)]) BODY...)

;; Wrong number of arguments.
(assert-eq (macro)
           (error `(too-few-args-to-builtin ~macro 0 2)))
(assert-eq (macro 1)
           (error `(too-few-args-to-builtin ~macro 1 2)))

;; Wrong type of argument.
(assert-eq (macro 1 nil)
           (error `(wrong-type-arg-to-builtin ~macro 1 ~list-t)))
(assert-eq (macro (1 a) nil)
           (error `(wrong-type-arg-to-builtin ~macro (1 a)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (1))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1 2)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (1 2))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (1 2 3)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (1 2 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (abc 3)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (abc 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (rest 3)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c (rest 3)) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c (rest 3))
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))
(assert-eq (macro (a b c 1) nil)
           (error `(wrong-type-arg-to-builtin ~macro (a b c 1)
                        "argument list must be in the form ([SYMBOL...] [(rest SYMBOL)])")))

;; Argument matching.
(let ((func (macro () ())))
  (assert-eq (func) ())
  (assert-eq (func 1)
             (error `(too-many-args ~func))))

(let ((func (macro (a) `'(~a))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1) '(1))
  (assert-eq (func 1 2)
             (error `(too-many-args ~func))))

(let ((func (macro (a b) `'(~a ~b))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2) '(1 2))
  (assert-eq (func 1 2 3)
             (error `(too-many-args ~func))))

(let ((func (macro (a b c) `'(~a ~b ~c))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2 3) '(1 2 3))
  (assert-eq (func 1 2 3 4)
             (error `(too-many-args ~func))))

(let ((func (macro ((rest r)) `'(~r))))
  (assert-eq (func) '(()))
  (assert-eq (func 1) '((1)))
  (assert-eq (func 1 2) '((1 2))))

(let ((func (macro (a (rest r)) `'(~a ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1) '(1 ()))
  (assert-eq (func 1 2) '(1 (2)))
  (assert-eq (func 1 2 3) '(1 (2 3))))

(let ((func (macro (a b (rest r)) `'(~a ~b ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2) '(1 2 ()))
  (assert-eq (func 1 2 3) '(1 2 (3))))

(let ((func (macro (a b c (rest r)) `'(~a ~b ~c ~r))))
  (assert-eq (func)
             (error `(too-few-args ~func)))
  (assert-eq (func 1)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2)
             (error `(too-few-args ~func)))
  (assert-eq (func 1 2 3) '(1 2 3 ())))

(include "core/assert.l")

;; `<` structure: (< X Y)

;; Wrong number of arguments.
(assert-eq (<)
           (error (list 'wrong-number-of-args-to-builtin < 0 2)))
(assert-eq (< 1)
           (error (list 'wrong-number-of-args-to-builtin < 1 2)))
(assert-eq (< 1 2 3)
           (error (list 'wrong-number-of-args-to-builtin < 3 2)))
(assert-eq (< 1 2 3 4)
           (error (list 'wrong-number-of-args-to-builtin < 4 2)))

;; Wrong type of arguments.
(assert-eq (< "abc" 1)
           (error (list 'wrong-type-arg-to-builtin < "abc" int64-t)))
(assert-eq (< 1 "abc")
           (error (list 'wrong-type-arg-to-builtin < "abc" int64-t)))

;; Error as argument.
(assert-eq (< (error "this") "that")
           (error (list 'wrong-type-arg-to-builtin < (error "this") int64-t)))
(assert-eq (< "that" (error "this"))
           (error (list 'wrong-type-arg-to-builtin < "that" int64-t)))

;; Behavior tests.
(setg check-less-than (fn (a b)
                          (assert-eq (< a b) true)
                          (assert-eq (< b a) false)))

(check-less-than -9223372036854775808 -9223372036854775807)
(check-less-than -9223372036854775808 -2)
(check-less-than -9223372036854775808 -1)
(check-less-than -9223372036854775808 0)
(check-less-than -9223372036854775808 1)
(check-less-than -9223372036854775808 2)
(check-less-than -9223372036854775808 9223372036854775807)
(check-less-than -9223372036854775807 -2)
(check-less-than -9223372036854775807 -1)
(check-less-than -9223372036854775807 0)
(check-less-than -9223372036854775807 1)
(check-less-than -9223372036854775807 2)
(check-less-than -9223372036854775807 9223372036854775807)
